# ─────────────────────────────────────────────────────────────────────────────
#  Application  (§75 environments, §60 settings)
# ─────────────────────────────────────────────────────────────────────────────
APP_NAME="EduPlatform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# ─────────────────────────────────────────────────────────────────────────────
#  Logging & observability (§77). Never log secrets — see SensitiveDataScrubber.
# ─────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_RETENTION_DAYS=14
PAYMENT_LOG_RETENTION_DAYS=730

# ─────────────────────────────────────────────────────────────────────────────
#  Database (§96.3). MySQL 8.x / MariaDB 10.6+.
#  SQLite is NOT supported: the schema uses FULLTEXT indexes and CHECK
#  constraints (docs/04 §0). Tests therefore run against MySQL in CI.
# ─────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eduplatform
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_SOCKET=

# ─────────────────────────────────────────────────────────────────────────────
#  Drivers — shared-hosting defaults (§69). Swap to redis without code changes.
# ─────────────────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
#  Mail (§51, §52). Use 'log' locally; SMTP on cPanel.
# ─────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@eduplatform.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
#  S3-compatible storage (§59, §98) — optional; files.disk is per-row so the
#  migration to object storage can be gradual.
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─────────────────────────────────────────────────────────────────────────────
#  Paystack (§41–§43). MODE is independent of APP_ENV (§75).
#  NEVER commit real keys. The secret key must never reach a view, JS bundle
#  or log line — enforced by test.
# ─────────────────────────────────────────────────────────────────────────────
# Master switch. When false the platform does not render any payment entry point
# at all, rather than rendering one that cannot complete (§63).
PAYSTACK_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_TEST_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_TEST_SECRET_KEY=sk_test_replace_me
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_WEBHOOK_URL="${APP_URL}/webhooks/paystack"
PAYSTACK_CALLBACK_URL="${APP_URL}/payments/paystack/callback"
# Off by default: shared hosts often sit behind proxies that rewrite REMOTE_ADDR.
# Signature verification is the primary control (docs/08 §1.5).
PAYSTACK_WEBHOOK_IP_ALLOWLIST=
PAYSTACK_TIMEOUT=30
PAYSTACK_RETRY_TIMES=3

# ─────────────────────────────────────────────────────────────────────────────
#  Google — OAuth login (§3) and Meet via the Calendar API (§36).
#  Meet links require scope calendar.events and conferenceDataVersion=1.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
GOOGLE_MEET_REDIRECT_URI="${APP_URL}/integrations/google/callback"
GOOGLE_MEET_ENABLED=false
GOOGLE_ORG_CALENDAR_ID=
GOOGLE_ORG_REFRESH_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
#  Microsoft / Entra ID — OAuth login (§3)
# ─────────────────────────────────────────────────────────────────────────────
MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
MICROSOFT_TENANT=common

# ─────────────────────────────────────────────────────────────────────────────
#  Zoom (§37). JWT apps are retired: use User-managed OAuth (tutor connects
#  their own account) and/or Server-to-Server OAuth (org-level fallback).
#  NOTE: for user-managed apps an account ADMIN must install the app, or the
#  meeting scopes fail with "Invalid scope" (docs/08 §3.1).
# ─────────────────────────────────────────────────────────────────────────────
ZOOM_ENABLED=false
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI="${APP_URL}/integrations/zoom/callback"
ZOOM_S2S_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
#  Platform behaviour. Non-secret business defaults live in the `settings`
#  table and are editable in the admin UI (§60, §95).
# ─────────────────────────────────────────────────────────────────────────────
PLATFORM_DEFAULT_TIMEZONE="Africa/Lagos"
PLATFORM_DEFAULT_CURRENCY=NGN
PLATFORM_DEFAULT_VIDEO_PROVIDER=manual
PLATFORM_SUPPORT_EMAIL="support@eduplatform.test"
# MUST be false in production (§74). The demo-login route is not even
# registered when this is false.
PLATFORM_DEMO_ACCOUNTS=true
PLATFORM_DEMO_PASSWORD=password

VITE_APP_NAME="${APP_NAME}"
