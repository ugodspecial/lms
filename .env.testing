# ─────────────────────────────────────────────────────────────────────────────
#  .env.testing — automated test environment
# ─────────────────────────────────────────────────────────────────────────────
#
#  Loaded INSTEAD of .env when APP_ENV=testing (which phpunit.xml sets).
#
#  Two rules govern this file (§72):
#
#    1. It points at a DEDICATED database. `migrate:fresh` drops every table in
#       the configured database before the suite runs. If DB_DATABASE here were
#       ever the same as a development or production database, running the tests
#       would destroy it. The name below is deliberately distinct.
#
#    2. It contains NO real credentials of any kind — no live Paystack key, no
#       real Google or Zoom client secret. Every external call in the suite is
#       faked (Http::fake / Bus::fake / Mail::fake / a manual gateway double).
#       A real key here would eventually be committed, and a committed key is a
#       compromised merchant account.
#
#  Values in phpunit.xml <env> entries are defaults only: a real environment
#  variable always wins, so CI can supply its own database credentials without
#  editing this file.
#
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME="EduPlatform Tests"
APP_ENV=testing
APP_KEY=base64:dGVzdGluZ2tleXRoYXRpczMyYnl0ZXNsb25nb2s=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

# Deterministic, fast, and no external side effects.
BCRYPT_ROUNDS=4
LOG_CHANNEL=single
LOG_LEVEL=error
MAIL_MAILER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# ── Database ────────────────────────────────────────────────────────────────
# MySQL, not SQLite: the schema depends on FULLTEXT indexes and enforced CHECK
# constraints (docs/04 §0), neither of which SQLite provides.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eduplatform_test
DB_USERNAME=root
DB_PASSWORD=

# ── Integrations: all off, all fake ─────────────────────────────────────────
PAYSTACK_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_TEST_PUBLIC_KEY=pk_test_fake_for_ci
PAYSTACK_TEST_SECRET_KEY=sk_test_fake_for_ci
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_LIVE_SECRET_KEY=

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MEET_ENABLED=false

MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

ZOOM_ENABLED=false
ZOOM_S2S_ENABLED=false
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ── Platform ────────────────────────────────────────────────────────────────
PLATFORM_DEMO_ACCOUNTS=false
PLATFORM_DEFAULT_TIMEZONE="Africa/Lagos"
PLATFORM_DEFAULT_CURRENCY=NGN
PLATFORM_DEFAULT_VIDEO_PROVIDER=manual
PLATFORM_SUPPORT_EMAIL="support@eduplatform.test"

MAIL_FROM_ADDRESS="no-reply@eduplatform.test"
MAIL_FROM_NAME="${APP_NAME}"
