{
    "$schema": "https://getcomposer.org/schema.json",
    "preset": "laravel",
    "notName": [
        "*.blade.php",
        "manifest.json",
        "*.min.js",
        "*.min.css"
    ],
    "exclude": [
        "storage",
        "public/build",
        "bootstrap/cache",
        "vendor",
        "docs",
        "node_modules"
    ],
    "rules": {
        "array_syntax": {
            "syntax": "short"
        },
        "no_unused_imports": true,
        "ordered_imports": {
            "sort_algorithm": "alpha"
        },
        "phpdoc_align": {
            "align": "left"
        },
        "phpdoc_order": true,
        "phpdoc_separation": true,
        "single_line_empty_body": true,
        "trailing_comma_in_multiline": {
            "after_heredoc": true,
            "elements": [
                "arguments",
                "array_destructuring",
                "arrays",
                "match",
                "parameters"
            ]
        }
    }
}
